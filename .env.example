# Port the Express server listens on
PORT=5000

# MongoDB connection string (local MongoDB or MongoDB Atlas).
# Leave empty to use a built-in local MongoDB (mongodb-memory-server) that
# stores its data in the ./.data folder — handy when MongoDB isn't installed.
MONGO_URI=

# Secret used to sign login tokens — change this to a long random string
JWT_SECRET=change-me-to-a-long-random-string
